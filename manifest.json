{
  "manifest_version": 3,
  "name": "Youtube plus",
  "version": "1.1.0",
  "description": "Perbaikan youtube",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js",
        "lyrics.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
